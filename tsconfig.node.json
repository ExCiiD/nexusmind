{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./out",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "composite": true,
    "types": ["electron-vite/node"]
  },
  "include": ["electron/**/*", "src/lib/constants/fundamentals.ts", "src/lib/championRoles.ts", "src/lib/collab.ts", "src/lib/collabCore.ts", "src/lib/feedback.ts", "src/lib/accessCore.ts", "src/lib/notifications.ts", "src/lib/notificationsCore.ts", "src/lib/team.ts", "src/lib/teamCore.ts", "src/lib/staffDashboard.ts", "src/lib/staffDashboardCore.ts", "src/lib/devPlan.ts", "src/lib/devPlanCore.ts", "src/lib/calendar.ts", "src/lib/calendarCore.ts", "src/lib/vodReview.ts", "src/lib/vodReviewCore.ts", "src/lib/wellbeing.ts", "src/lib/wellbeingCore.ts"]
}
