{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./out",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "composite": true,
    "types": ["electron-vite/node"]
  },
  "include": ["electron/**/*", "src/lib/constants/fundamentals.ts", "src/lib/championRoles.ts", "src/lib/collab.ts", "src/lib/collabCore.ts", "src/lib/feedback.ts"]
}
