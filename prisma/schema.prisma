generator client {
  provider = "prisma-client-js"
  output   = "../prisma-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String       @id @default(cuid())
  displayName        String       @default("")
  summonerName       String
  puuid              String       @unique
  tagLine            String       @default("")
  region             String
  /// 'auto' (found from the puuid) or the platform the player chose (20/11/2026)
  regionMode         String       @default("auto")
  /// "I do my reviews myself" / "I tag my mistakes myself" (21/11/2026): no micro-review saved, no auto-detected mistake
  selfReview         Boolean      @default(false)
  selfTagMistakes    Boolean      @default(false)
  preferences        UserPreference[]
  /// Server before a transfer: the older games stay there
  previousRegion     String?
  assessmentFreqDays Int          @default(14)
  nextAssessmentAt   DateTime
  xp                 Int          @default(0)
  streakDays         Int          @default(0)
  lastActiveDate     DateTime?
  queueFilter        String       @default("both")
  mainRole           String?
  profileIconId      Int          @default(0)
  isActive           Boolean      @default(true)
  autoRecord         Boolean      @default(false)
  recordingPath          String?
  externalRecordingPath  String?
  discordWebhookUrl      String?
  recordQuality          String       @default("source")
  recordFps          Int          @default(30)
  recordEncoder      String       @default("nvenc")
  recordScope            String       @default("ranked_only")
  recordAllowCustom      Boolean      @default(false)
  allowDesktopFallback   Boolean      @default(true)
  recordAudioDesktop     Boolean      @default(true)
  recordAudioDesktopDevice String?
  /// On for every profile since 20261119130000_mic_on_by_default (and set on
  /// creation in auth:login); the column default stays false to avoid a
  /// User table rebuild.
  recordAudioMic         Boolean      @default(false)
  recordAudioMicDevice   String?
  /// Minimize Ascend and let Chromium throttle it while a game is recorded (electron/main/windowFocus.ts).
  recordInBackground     Boolean      @default(true)
  /// Bring Ascend to the front on the review page once a game and its recording are over.
  reviewPopup            Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  sessions           Session[]
  assessments        Assessment[]
  badges             Badge[]
  accounts           Account[]
  discordWebhooks    DiscordWebhook[]
  teams              Team[]
  drafts             DraftPrep[]
  assistantFeedback  AssistantFeedback[]
  adviceLogs         AdviceLog[]
  coachingExperiments CoachingExperiment[]
  mistakeTagTunings    MistakeTagTuning[]
  microReviewAnswers   MicroReviewAnswer[]
  calibrationFlashes   CalibrationFlash[]
}

model Account {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puuid         String   @unique
  gameName      String
  tagLine       String
  region        String
  regionMode    String   @default("auto")
  previousRegion String?
  profileIconId Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Assessment {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  scores    AssessmentScore[]
}

model AssessmentScore {
  id            String     @id @default(cuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  fundamentalId String
  subcategoryId String?
  score         Int

  @@unique([assessmentId, fundamentalId, subcategoryId])
}

model Session {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime @default(now())
  objectiveId     String
  objectiveIds    String   @default("[]")
  /// Written objectives (21/11/2026): JSON [{ id, text, source: self | coach, assignedObjectiveId? }]. With them, a
  /// session may have no fundamental (objectiveId empty).
  customObjectives String  @default("[]")
  selectedKpiIds  String   @default("[]")
  subObjective       String?
  customNote         String?
  status             String   @default("active")
  aiSummary          String?
  sessionConclusion  String?
  /// 27/11/2026: started by Ascend itself when a game began with no active session (no objective needed). Closed by the
  /// idle rule (sessionAutoClose.ts); deleted when it never got a game.
  autoStarted        Boolean  @default(false)
  /// The "add an objective" bubble was dismissed for this session.
  objectivePromptDismissed Boolean @default(false)
  games              Game[]

  @@index([userId, status])
}

model Game {
  id               String   @id @default(cuid())
  sessionId        String
  session          Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  matchId          String   @unique
  champion         String
  opponentChampion String?
  reviewStatus     String   @default("pending")
  role             String
  kills            Int
  deaths           Int
  assists          Int
  cs               Int
  visionScore      Int
  duration         Int
  win              Boolean
  rank             String?
  lp               Int?
  gameEndAt        DateTime
  queueType        String   @default("unknown")
  isSessionEligible Boolean  @default(true)
  // JSON-encoded LanePhaseReport (electron/main/lanePhaseAnalyzer.ts).
  // Computed lazily by `stats:get-lane-phase` and cached so the renderer
  // doesn't re-parse a 1-2 MB Riot timeline on every page open.
  lanePhaseReport  String?
  review           Review?
  detailedStats    GameDetailedStats?
  recording        Recording?
  mistakes         Mistake[]
  analysis         GameAnalysis?
  microReviewAnswers MicroReviewAnswer[]

  @@index([sessionId])
}

/// What the History and the Dashboard show of one match for one of the player's accounts (AUDIT_PERF_2 gain 7):
/// extractPlayerStats, stored when the match is written. Local, not synced.
model MatchSummary {
  matchId   String
  puuid     String
  /// Version of the summary's formula: another version is computed again
  version   Int
  gameEndAt DateTime?
  statsJson String
  createdAt DateTime  @default(now())

  @@id([matchId, puuid])
}

/// Detailed stats of a match for a player, kept across restarts (AUDIT_PERF_2 gain 1). Local, not synced.
model DetailedStatsMemo {
  matchId   String
  puuid     String
  version   Int
  statsJson String
  createdAt DateTime @default(now())

  @@id([matchId, puuid])
}

/// Auto-detected mistakes the player deleted (21/11/2026): the detection does not create them again (same game and
/// tag, within 20 s). Local, not synced.
model IgnoredMistake {
  id          String   @id @default(cuid())
  gameId      String
  tagSlug     String
  gameTimeSec Int
  createdAt   DateTime @default(now())

  @@index([gameId])
}

/// Every removal or retag of an auto-detected mistake by the player (21/11/2026, layer 1 of "the engine learns from
/// corrections"): the rule's tag, what the player did, why (optional), and the context. Local only, never uploaded.
model MistakeCorrection {
  id              String   @id @default(cuid())
  mistakeId       String
  gameId          String
  /// The tag the detection gave (its rule)
  ruleTag         String
  /// removed | retagged
  action          String
  newTag          String?
  /// not_a_mistake | wrong_tag | wrong_time | team_context | other
  reason          String?
  note            String?
  analysisVersion Int
  role            String?
  queueType       String?
  createdAt       DateTime @default(now())

  @@index([ruleTag])
}

/// A player's settings that follow them on every device (21/11/2026): synced, one row per key, a validated JSON value.
model UserPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, key])
}

/// Match ids the start-up catch-up must not import (20/11/2026, electron/main/ignoredMatches.ts):
/// deleted by the player, or unknown to Riot (practice tool). Local to this PC, not synced.
model IgnoredMatch {
  matchId   String   @id
  /// 'deleted' | 'not_found'
  reason    String
  createdAt DateTime @default(now())
}

model GameDetailedStats {
  id        String   @id @default(cuid())
  gameId    String   @unique
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  stats     String
  createdAt DateTime @default(now())
}

model MatchCache {
  id           String   @id @default(cuid())
  matchId      String   @unique
  matchJson    String
  timelineJson String?
  createdAt    DateTime @default(now())
}

// Players a user has chosen to compare their "fundamentals radar" against
// (Dashboard), identified by their resolved puuid rather than their Riot ID
// so a later name change by the tracked player never breaks the comparison.
model FollowedPlayer {
  id         String   @id @default(cuid())
  userId     String
  gameName   String
  tagLine    String
  region     String
  puuid      String
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, puuid])
  @@index([userId])
}

model Review {
  id                 String   @id @default(cuid())
  gameId             String   @unique
  game               Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  timelineNotes      String
  kpiScores          String
  kpiNotes           String?
  freeText           String?
  aiSummary          String?
  objectiveRespected Boolean
  /// Per written objective of the session: JSON [{ id, result: yes | no | partial, note? }] (21/11/2026)
  customObjectiveResults String @default("[]")
  createdAt          DateTime @default(now())
}

model Recording {
  id             String   @id @default(cuid())
  gameId         String?  @unique
  game           Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  filePath       String?
  youtubeUrl     String?
  source         String   @default("manual")
  duration       Int?
  thumbnailPath  String?
  // Seconds between the in-game start (derived from gameEndAt - gameDuration)
  // and the moment the recording file started writing (file birthtime).
  // Used by the player to align timeline event markers (kills/dragons/etc)
  // with the actual video playback time. Nullable for legacy rows.
  startOffsetSec Float?
  createdAt      DateTime @default(now())
  clips          Clip[]
  mistakes       Mistake[]
  bookmarks      Bookmark[]
}

// ── Bookmarks ────────────────────────────────────────────────────────────
// Free-form per-recording markers — lighter than a Mistake (no tag, no
// game-time anchoring). Anchored to the video timeline so they work even
// on orphan recordings that have no linked Game.

model Bookmark {
  id          String   @id @default(cuid())
  recordingId String
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  videoTimeMs Int
  label       String?
  color       String?
  createdAt   DateTime @default(now())

  @@index([recordingId])
}

model Clip {
  id              String    @id @default(cuid())
  recordingId     String
  recording       Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  filePath        String
  thumbnailPath   String?
  title           String?
  startMs         Int
  endMs           Int
  linkedNoteText  String?
  youtubeUrl      String?
  tempShareUrl    String?
  tempShareExpiry DateTime?
  createdAt       DateTime  @default(now())

  @@index([recordingId])
}

model StatsSnapshot {
  id           String   @id @default(cuid())
  userId       String
  mainRole     String?
  stats        String
  gameCount    Int
  firstGameAt  DateTime
  lastGameAt   DateTime
  createdAt    DateTime @default(now())
}

model ExternalReview {
  id              String   @id @default(cuid())
  userId          String
  title           String
  objectiveId     String?
  objectiveIds    String   @default("[]")
  selectedKpiIds  String   @default("[]")
  kpiScores       String   @default("{}")
  timelineNotes   String   @default("[]")
  freeText        String?
  filePath        String?
  playerName      String?
  matchData       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model DiscordWebhook {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  url       String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Badge {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId    String
  unlockedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

// ── Team management (Drafter-style) ──────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tag         String?
  logo        String?
  notes       String?
  // Distinguishes "my team" (false) from "opponent teams scouted for prep" (true)
  isOpponent  Boolean  @default(false)
  scoutNotes  String?  // markdown for opponent intel
  /// The cloud group (Coaching & Management) this team is the roster of: the
  /// group picked in the header shows this team in Coaching and Stats
  /// collectives. One team per group (team:link-group keeps it so).
  groupId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     TeamMember[]
  drafts      DraftPrep[] @relation("DraftVsTeam")
  customGames CustomGame[]
  weeklyAwards TeamWeeklyAward[]

  @@index([userId])
  @@index([groupId])
}

/**
 * User-imported custom games (scrim / tournament) parsed from a Replaybook
 * CSV export. We store the parsed per-participant rows as a JSON blob so we
 * can compute the same averages/shares as our Riot synergy stats without
 * locking into a rigid column schema (replaybook output may evolve).
 */
model CustomGame {
  id           String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // 'scrim' | 'tournament'
  gameType     String
  // When the game was played (parsed from CSV if available, else now())
  gameDate     DateTime?
  durationSec  Int
  // Whether OUR team won — null when ambiguous (e.g. CSV doesn't include
  // which side we were on). Most consumers can rely on per-participant `win`.
  win          Boolean?
  // JSON array of participant rows. Normalized to mostly match Riot's
  // match-V5 participant shape for downstream reuse:
  //   { playerName, championName, teamId, teamPosition, win,
  //     kills, deaths, assists, totalDamageDealtToChampions,
  //     totalDamageTaken, goldEarned, totalMinionsKilled,
  //     neutralMinionsKilled, visionScore, wardsPlaced, wardsKilled,
  //     detectorWardsPurchased, timeCCingOthers, champExperience }
  participantsJson String
  // Original CSV filename — useful for traceability and de-dup hints.
  sourceFile   String?
  notes        String?
  importedAt   DateTime @default(now())

  @@index([teamId])
  @@index([teamId, gameType])
}

model TeamMember {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  displayName String
  ign         String?  // in-game name
  tagLine     String?
  region      String?
  // TOP | JUNGLE | MID | ADC | SUPPORT
  role        String
  // Riot puuid if known — used for scouting auto-fetch (optional, manual entry OK)
  puuid       String?
  /// #38: the Riot ID ("Name#TAG") the player had before a rename was applied (Riot by puuid, or the group). The
  /// screens show it instead of switching the name silently, then clear it (updateTeamMember, previousRiotId: null).
  previousRiotId String?
  champPool   ChampionPoolEntry[]
  // E15 incremental scout/auto-fill: the season match-id list as of the
  // last scout, so a repeat scout only has to ask Riot for games played
  // AFTER this instead of re-listing the whole season every time (ids are
  // cheap individually but the full season is up to ~25 paginated list
  // calls; most repeat scouts find 0-5 new games). Full-season re-walk of
  // the (now mostly cached) match bodies still happens — this only saves
  // the id-listing round trips, so tiering math is unaffected. Null until
  // the first scout/auto-fill; a "Complete" scope rescan always ignores
  // these and relists from scratch.
  lastScoutedAt     DateTime?
  seasonMatchIdsJson String?

  @@index([teamId])
}

model ChampionPoolEntry {
  id          String   @id @default(cuid())
  memberId    String
  member      TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  championKey String   // Data Dragon key, ex: "Renekton"
  role        String
  // main | comfort | flex | learning
  tier        String   @default("comfort")
  notes       String?
  playRate    Int?     // recent play count (auto-populated by scouting)
  winRate     Int?     // %, optional manual
  // Riot champion-mastery points, used by Draft Sim to surface "threat"
  // picks (300k+ = orange ring, dominant most-played = red, multi-opponent
  // overlap = yellow). Nullable for legacy entries created before this
  // column existed and for manual entries that never went through auto-fill.
  masteryPoints Int?
  // Average (kills+assists)/max(1,deaths) across the scouted/filled games
  // for this champion+role, aggregated for free from match participant data
  // already fetched during scout/auto-fill (no extra Riot calls). Feeds the
  // "high win rate or KDA" threat signal (src/lib/threatCore.ts), gated by a
  // 20-game minimum so a 2-game sample can't fake a 10.0 KDA. Null for
  // legacy/manual entries or mastery-only entries with 0 games.
  kda         Float?
  // First and last analysed game on this champion in this role, written by
  // auto-fill / scouting. They drive the "new" tier (picked up less than two
  // weeks ago, 10+ games since) and the drop of a main not played for 30
  // days (src/lib/threatCore.ts). Null for manual, mastery-only and pre-v2
  // entries.
  firstPlayedAt DateTime?
  lastPlayedAt  DateTime?
  // The tier the rule computed last time. `tier` differing from it means
  // the user picked the tier by hand: auto-fill and the start-up refresh
  // then leave it alone. Null until the entry is tiered by the v2 rule.
  autoTier    String?
  updatedAt   DateTime @updatedAt

  @@index([memberId, role])
  @@unique([memberId, championKey, role])
}

// ── Mistake Library ──────────────────────────────────────────────────────────
// Lets the user tag specific moments in a recorded game with a "mistake"
// (e.g. overstay, dove-tower, late-back) and aggregate frequency over
// time. Tags are either built-in (seeded on first launch — `isBuiltIn=true`)
// or user-defined. Mistakes are scoped to a Game so they appear on the
// timeline of any recording linked to that game.

model MistakeTag {
  tunings  MistakeTagTuning[]
  id          String   @id @default(cuid())
  slug        String   @unique
  label       String
  // "macro" | "micro" | "vision" | "economy" | "draft"
  category    String
  // Optional lucide-react icon name and CSS color string (renderer-side)
  icon        String?
  color       String?
  isBuiltIn   Boolean  @default(false)
  // Soft-delete — keeps historical Mistake rows pointing to a valid tag
  // even after the user "deletes" it from the active list.
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  mistakes    Mistake[]
}

model Mistake {
  id           String   @id @default(cuid())
  gameId       String
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  // Optional link to a specific recording (handy when one game has
  // multiple recordings, e.g. dual VOD from main + smurf review).
  recordingId  String?
  recording    Recording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  tagId        String
  tag          MistakeTag @relation(fields: [tagId], references: [id], onDelete: Restrict)
  // In-game seconds where the mistake occurred — used to render markers
  // on the video player timeline (offset by Recording.startOffsetSec).
  gameTimeSec  Int
  // Optional video-time copy (ms) so we don't need to recompute the offset
  // when seeking from the side list — performance optimisation.
  videoTimeMs  Int?
  note         String?
  // 1 = minor, 2 = standard, 3 = critical — drives marker thickness.
  severity     Int      @default(2)
  // True when the row was created by mistakeDetector.ts heuristics rather
  // than by the user. Lets the UI hide them behind a toggle until trusted.
  autoDetected Boolean  @default(false)
  /// 21/11/2026 « Repères de la micro-review »: the window the player set (error − 5 s .. consequence + 5 s); null = usual window.
  startSec     Int?
  endSec       Int?
  createdAt    DateTime @default(now())

  @@index([gameId])
  @@index([tagId, createdAt])
}

model DraftPrep {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  // Optional: link to an opponent team that was scouted
  vsTeamId    String?
  vsTeam      Team?    @relation("DraftVsTeam", fields: [vsTeamId], references: [id], onDelete: SetNull)
  // JSON-encoded arrays of champion keys (size matters — 5 picks, 5 bans per side)
  bluePicks   String   @default("[]")
  blueBans    String   @default("[]")
  redPicks    String   @default("[]")
  redBans     String   @default("[]")
  // blue | red — which side is "us" for win-condition tagging
  myTeamSide  String   @default("blue")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ── Assistant (Phase A) ──────────────────────────────────────────────────
// Local thumbs up/down on rule-based insights (electron/main/assistant/).
// Tallied per rule to re-weight what the assistant surfaces for this player.

model AssistantFeedback {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleId     String
  // Rule id + subject (game / session / week) — one vote per insight instance.
  insightKey String
  // post_game | session | weekly
  moment     String
  // 1 = helpful, -1 = not helpful
  vote       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, insightKey])
  @@index([userId, ruleId])
}

// Coaching engine: which problem the assistant put forward, once per day
// (anti-repetition and, later, outcome-based learning).
model AdviceLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // problems.ts id, e.g. "farming"
  problemId  String
  // Lead insight shown for that problem (rule + subject)
  insightKey String
  // post_game | session | weekly
  moment     String
  // Local day, YYYY-MM-DD
  day        String
  shownAt    DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, problemId, day])
  @@index([userId, shownAt])
}

// Coaching engine (lot 2): a prescription tested on the next N games, then a
// verdict (acquired / progressing / no_effect). Criterion and baseline are JSON.
model CoachingExperiment {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId     String
  fundamentalId String?
  // Rule that prescribed it (outcome-based learning), if any
  ruleId        String?
  tagSlug       String?
  // JSON: { kind: 'metric', metric, op, target } | { kind: 'noMistake', tags }
  criterion     String
  // JSON: { mean?, rate?, games }
  baseline      String
  windowGames   Int       @default(5)
  // assistant | session | player | coach
  source        String    @default("assistant")
  // active | done | abandoned
  status        String    @default("active")
  // acquired | progressing | no_effect
  verdict       String?
  passRate      Float?
  // JSON GameResult[] frozen at the verdict
  results       String?
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([userId, status])
}

// MX3: learned severity threshold. One row per (player, tag); updated when
// the player deletes an auto-detected mistake of that tag, read when a new
// one is auto-detected (stats.ipc.ts autoDetectMistakesSilently).
model MistakeTagTuning {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tagId         String
  tag           MistakeTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  deletedCount  Int        @default(0)
  severityDelta Int        @default(0)
  updatedAt     DateTime   @updatedAt

  @@unique([userId, tagId])
}

// ── Micro-review (docs/PLAN_MICRO_REVIEW.md) ────────────────────────────
// Local only (not in SYNC_TABLES): derived data + the player's own answers.

// Cached AnomalyDetector output for a game (win-probability curve, <= 3
// critical moments, contested objectives). Recomputed when `version` changes.
model GameAnalysis {
  id        String   @id @default(cuid())
  gameId    String   @unique
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  version   Int
  // JSON: GameAnalysis (src/lib/microReview/anomalyDetector.ts)
  payload   String
  // XP for completing the micro-review: once per game, even after a recompute.
  reviewXpAwarded Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One answer of the guided micro-review QCM. outcome = justified creates no
// Mistake row (never counts against the player); mistake / custom point at
// the Mistake they created. Also the local-learning dataset (choice
// frequency per role / champion).
model MicroReviewAnswer {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  momentKey   String
  // critical-death | absent-objective | early-deficit
  trigger     String
  gameTimeSec Int
  // mistake | justified | custom
  outcome     String
  tagSlug     String?
  // reason id of the button (microReview.reason.*), null for "Autre cause"
  reason      String?
  viaOther    Boolean  @default(false)
  note        String?
  role        String
  champion    String
  mistakeId   String?
  // created | confirmed-auto | existing — what re-answering may undo (see migration)
  mistakeOrigin String?
  /// Manual mistakes the answer added for its extra tags, and its bookmark: undone on re-answer (21/11/2026)
  extraMistakeIds String  @default("[]")
  bookmarkId      String?
  /// 21/11/2026: the precise timestamps the player set on the moment (optional, one or both).
  errorAtSec       Int?
  consequenceAtSec Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([gameId, momentKey])
  @@index([userId, role])
}

// Calibration flash (every 15 games): perceived costliest family vs the
// family the micro-review data points at.
model CalibrationFlash {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  perceived   String
  measuredTop String?
  gapPts      Int
  evidence    Int
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// ── Weekly awards (Espace d'équipe: MVP and Grinder frames on the roster) ──
// src/lib/weeklyAwardsCore.ts. Local only (not in SYNC_TABLES): derived from
// Riot data, each device keeps its own.

// One reading of a player's rank in one queue (league-v4). A new row only when
// the reading changes; seenAt moves forward while it stays the same. Riot keeps
// no LP history: the Grinder award reads the LP won over a week from here.
model RankSnapshot {
  id       String   @id @default(cuid())
  puuid    String
  // solo | flex
  queue    String
  tier     String
  // IV..I, null from Master up
  division String?
  lp       Int
  wins     Int
  losses   Int
  // rankCore.ladderScore: 400 per tier, 100 per division, LP
  ladder   Int
  takenAt  DateTime @default(now())
  seenAt   DateTime @default(now())

  @@index([puuid, queue, takenAt])
}

// MVP score of one player in one game (weeklyAwardsCore.scoreGame), so a
// week's ranking never re-reads match bodies. score null: the game doesn't
// count (other queue, remake). Recomputed when version changes.
model PlayerGameScore {
  id          String   @id @default(cuid())
  puuid       String
  matchId     String
  queueId     Int
  playedAt    DateTime
  durationSec Int
  role        String?
  win         Boolean
  score       Float?
  version     Int
  createdAt   DateTime @default(now())

  @@unique([puuid, matchId])
  @@index([puuid, playedAt])
}

// Result of one award (mvp | grinder) for one completed week of a team, so
// streaks and totals never need recomputing. memberId / puuid null: nobody
// qualified that week.
model TeamWeeklyAward {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  kind      String
  // Local Monday of the week, YYYY-MM-DD
  weekKey   String
  weekStart DateTime
  memberId  String?
  puuid     String?
  value     Float?
  games     Int?
  // JSON: the week's ranking [{ memberId, value, games }], best first
  raceJson  String?
  createdAt DateTime @default(now())

  @@unique([teamId, kind, weekKey])
  @@index([teamId, weekKey])
}
