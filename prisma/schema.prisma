generator client {
  provider = "prisma-client-js"
  output   = "../prisma-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String       @id @default(cuid())
  displayName        String       @default("")
  summonerName       String
  puuid              String       @unique
  tagLine            String       @default("")
  region             String
  assessmentFreqDays Int          @default(14)
  nextAssessmentAt   DateTime
  xp                 Int          @default(0)
  streakDays         Int          @default(0)
  lastActiveDate     DateTime?
  queueFilter        String       @default("both")
  mainRole           String?
  profileIconId      Int          @default(0)
  isActive           Boolean      @default(true)
  autoRecord         Boolean      @default(false)
  recordingPath          String?
  externalRecordingPath  String?
  discordWebhookUrl      String?
  recordQuality          String       @default("source")
  recordFps          Int          @default(30)
  recordEncoder      String       @default("nvenc")
  recordScope            String       @default("ranked_only")
  recordAllowCustom      Boolean      @default(false)
  allowDesktopFallback   Boolean      @default(true)
  recordAudioDesktop     Boolean      @default(true)
  recordAudioDesktopDevice String?
  recordAudioMic         Boolean      @default(false)
  recordAudioMicDevice   String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  sessions           Session[]
  assessments        Assessment[]
  badges             Badge[]
  accounts           Account[]
  discordWebhooks    DiscordWebhook[]
  teams              Team[]
  drafts             DraftPrep[]
  assistantFeedback  AssistantFeedback[]
}

model Account {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puuid         String   @unique
  gameName      String
  tagLine       String
  region        String
  profileIconId Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Assessment {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  scores    AssessmentScore[]
}

model AssessmentScore {
  id            String     @id @default(cuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  fundamentalId String
  subcategoryId String?
  score         Int

  @@unique([assessmentId, fundamentalId, subcategoryId])
}

model Session {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime @default(now())
  objectiveId     String
  objectiveIds    String   @default("[]")
  selectedKpiIds  String   @default("[]")
  subObjective       String?
  customNote         String?
  status             String   @default("active")
  aiSummary          String?
  sessionConclusion  String?
  games              Game[]

  @@index([userId, status])
}

model Game {
  id               String   @id @default(cuid())
  sessionId        String
  session          Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  matchId          String   @unique
  champion         String
  opponentChampion String?
  reviewStatus     String   @default("pending")
  role             String
  kills            Int
  deaths           Int
  assists          Int
  cs               Int
  visionScore      Int
  duration         Int
  win              Boolean
  rank             String?
  lp               Int?
  gameEndAt        DateTime
  queueType        String   @default("unknown")
  isSessionEligible Boolean  @default(true)
  // JSON-encoded LanePhaseReport (electron/main/lanePhaseAnalyzer.ts).
  // Computed lazily by `stats:get-lane-phase` and cached so the renderer
  // doesn't re-parse a 1-2 MB Riot timeline on every page open.
  lanePhaseReport  String?
  review           Review?
  detailedStats    GameDetailedStats?
  recording        Recording?
  mistakes         Mistake[]

  @@index([sessionId])
}

model GameDetailedStats {
  id        String   @id @default(cuid())
  gameId    String   @unique
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  stats     String
  createdAt DateTime @default(now())
}

model MatchCache {
  id           String   @id @default(cuid())
  matchId      String   @unique
  matchJson    String
  timelineJson String?
  createdAt    DateTime @default(now())
}

model Review {
  id                 String   @id @default(cuid())
  gameId             String   @unique
  game               Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  timelineNotes      String
  kpiScores          String
  kpiNotes           String?
  freeText           String?
  aiSummary          String?
  objectiveRespected Boolean
  createdAt          DateTime @default(now())
}

model Recording {
  id             String   @id @default(cuid())
  gameId         String?  @unique
  game           Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  filePath       String?
  youtubeUrl     String?
  source         String   @default("manual")
  duration       Int?
  thumbnailPath  String?
  // Seconds between the in-game start (derived from gameEndAt - gameDuration)
  // and the moment the recording file started writing (file birthtime).
  // Used by the player to align timeline event markers (kills/dragons/etc)
  // with the actual video playback time. Nullable for legacy rows.
  startOffsetSec Float?
  createdAt      DateTime @default(now())
  clips          Clip[]
  mistakes       Mistake[]
  bookmarks      Bookmark[]
}

// ── Bookmarks ────────────────────────────────────────────────────────────
// Free-form per-recording markers — lighter than a Mistake (no tag, no
// game-time anchoring). Anchored to the video timeline so they work even
// on orphan recordings that have no linked Game.

model Bookmark {
  id          String   @id @default(cuid())
  recordingId String
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  videoTimeMs Int
  label       String?
  color       String?
  createdAt   DateTime @default(now())

  @@index([recordingId])
}

model Clip {
  id              String    @id @default(cuid())
  recordingId     String
  recording       Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  filePath        String
  thumbnailPath   String?
  title           String?
  startMs         Int
  endMs           Int
  linkedNoteText  String?
  youtubeUrl      String?
  tempShareUrl    String?
  tempShareExpiry DateTime?
  createdAt       DateTime  @default(now())

  @@index([recordingId])
}

model StatsSnapshot {
  id           String   @id @default(cuid())
  userId       String
  mainRole     String?
  stats        String
  gameCount    Int
  firstGameAt  DateTime
  lastGameAt   DateTime
  createdAt    DateTime @default(now())
}

model ExternalReview {
  id              String   @id @default(cuid())
  userId          String
  title           String
  objectiveId     String?
  objectiveIds    String   @default("[]")
  selectedKpiIds  String   @default("[]")
  kpiScores       String   @default("{}")
  timelineNotes   String   @default("[]")
  freeText        String?
  filePath        String?
  playerName      String?
  matchData       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model DiscordWebhook {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  url       String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Badge {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId    String
  unlockedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

// ── Team management (Drafter-style) ──────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tag         String?
  logo        String?
  notes       String?
  // Distinguishes "my team" (false) from "opponent teams scouted for prep" (true)
  isOpponent  Boolean  @default(false)
  scoutNotes  String?  // markdown for opponent intel
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     TeamMember[]
  drafts      DraftPrep[] @relation("DraftVsTeam")
  customGames CustomGame[]

  @@index([userId])
}

/**
 * User-imported custom games (scrim / tournament) parsed from a Replaybook
 * CSV export. We store the parsed per-participant rows as a JSON blob so we
 * can compute the same averages/shares as our Riot synergy stats without
 * locking into a rigid column schema (replaybook output may evolve).
 */
model CustomGame {
  id           String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // 'scrim' | 'tournament'
  gameType     String
  // When the game was played (parsed from CSV if available, else now())
  gameDate     DateTime?
  durationSec  Int
  // Whether OUR team won — null when ambiguous (e.g. CSV doesn't include
  // which side we were on). Most consumers can rely on per-participant `win`.
  win          Boolean?
  // JSON array of participant rows. Normalized to mostly match Riot's
  // match-V5 participant shape for downstream reuse:
  //   { playerName, championName, teamId, teamPosition, win,
  //     kills, deaths, assists, totalDamageDealtToChampions,
  //     totalDamageTaken, goldEarned, totalMinionsKilled,
  //     neutralMinionsKilled, visionScore, wardsPlaced, wardsKilled,
  //     detectorWardsPurchased, timeCCingOthers, champExperience }
  participantsJson String
  // Original CSV filename — useful for traceability and de-dup hints.
  sourceFile   String?
  notes        String?
  importedAt   DateTime @default(now())

  @@index([teamId])
  @@index([teamId, gameType])
}

model TeamMember {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  displayName String
  ign         String?  // in-game name
  tagLine     String?
  region      String?
  // TOP | JUNGLE | MID | ADC | SUPPORT
  role        String
  // Riot puuid if known — used for scouting auto-fetch (optional, manual entry OK)
  puuid       String?
  champPool   ChampionPoolEntry[]

  @@index([teamId])
}

model ChampionPoolEntry {
  id          String   @id @default(cuid())
  memberId    String
  member      TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  championKey String   // Data Dragon key, ex: "Renekton"
  role        String
  // main | comfort | flex | learning
  tier        String   @default("comfort")
  notes       String?
  playRate    Int?     // recent play count (auto-populated by scouting)
  winRate     Int?     // %, optional manual
  // Riot champion-mastery points, used by Draft Sim to surface "threat"
  // picks (300k+ = orange ring, dominant most-played = red, multi-opponent
  // overlap = yellow). Nullable for legacy entries created before this
  // column existed and for manual entries that never went through auto-fill.
  masteryPoints Int?
  updatedAt   DateTime @updatedAt

  @@index([memberId, role])
  @@unique([memberId, championKey, role])
}

// ── Mistake Library ──────────────────────────────────────────────────────────
// Lets the user tag specific moments in a recorded game with a "mistake"
// (e.g. overstay, dove-tower, late-back) and aggregate frequency over
// time. Tags are either built-in (seeded on first launch — `isBuiltIn=true`)
// or user-defined. Mistakes are scoped to a Game so they appear on the
// timeline of any recording linked to that game.

model MistakeTag {
  id          String   @id @default(cuid())
  slug        String   @unique
  label       String
  // "macro" | "micro" | "vision" | "economy" | "draft"
  category    String
  // Optional lucide-react icon name and CSS color string (renderer-side)
  icon        String?
  color       String?
  isBuiltIn   Boolean  @default(false)
  // Soft-delete — keeps historical Mistake rows pointing to a valid tag
  // even after the user "deletes" it from the active list.
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  mistakes    Mistake[]
}

model Mistake {
  id           String   @id @default(cuid())
  gameId       String
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  // Optional link to a specific recording (handy when one game has
  // multiple recordings, e.g. dual VOD from main + smurf review).
  recordingId  String?
  recording    Recording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  tagId        String
  tag          MistakeTag @relation(fields: [tagId], references: [id], onDelete: Restrict)
  // In-game seconds where the mistake occurred — used to render markers
  // on the video player timeline (offset by Recording.startOffsetSec).
  gameTimeSec  Int
  // Optional video-time copy (ms) so we don't need to recompute the offset
  // when seeking from the side list — performance optimisation.
  videoTimeMs  Int?
  note         String?
  // 1 = minor, 2 = standard, 3 = critical — drives marker thickness.
  severity     Int      @default(2)
  // True when the row was created by mistakeDetector.ts heuristics rather
  // than by the user. Lets the UI hide them behind a toggle until trusted.
  autoDetected Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([gameId])
  @@index([tagId, createdAt])
}

model DraftPrep {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  // Optional: link to an opponent team that was scouted
  vsTeamId    String?
  vsTeam      Team?    @relation("DraftVsTeam", fields: [vsTeamId], references: [id], onDelete: SetNull)
  // JSON-encoded arrays of champion keys (size matters — 5 picks, 5 bans per side)
  bluePicks   String   @default("[]")
  blueBans    String   @default("[]")
  redPicks    String   @default("[]")
  redBans     String   @default("[]")
  // blue | red — which side is "us" for win-condition tagging
  myTeamSide  String   @default("blue")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ── Assistant (Phase A) ──────────────────────────────────────────────────
// Local thumbs up/down on rule-based insights (electron/main/assistant/).
// Tallied per rule to re-weight what the assistant surfaces for this player.

model AssistantFeedback {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleId     String
  // Rule id + subject (game / session / week) — one vote per insight instance.
  insightKey String
  // post_game | session | weekly
  moment     String
  // 1 = helpful, -1 = not helpful
  vote       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, insightKey])
  @@index([userId, ruleId])
}
